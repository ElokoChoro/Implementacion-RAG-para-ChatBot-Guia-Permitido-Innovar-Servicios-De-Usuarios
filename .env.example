# Copia este archivo como .env. Configura el backend (Python). Las credenciales no se escriben a
# mano: se guardan con python -m app.rag.secretos guardar (ver secretos.py).

# Vector store del índice: chroma (local) o pgvector (Supabase)
ALMACEN=chroma
# SUPABASE_DB_URL (connection string de Postgres con la contraseña de la base) da acceso completo a
# la base. No la escribas a mano: guárdala desde backend/ con
#   ../.venv/bin/python -m app.rag.secretos guardar SUPABASE_DB_URL
# Si tu equipo tiene llavero (macOS, Windows, Linux con escritorio) queda cifrada ahí; si no (WSL,
# Linux sin escritorio), el comando la escribe en este archivo y lo deja legible solo para tu usuario.
# Para saber cuál es tu caso: ../.venv/bin/python -m app.rag.secretos donde

# LLM que redacta la respuesta (ver «LLM en cada equipo» en el README).
# ollama (por defecto) u openai: cualquier servidor compatible con la API de OpenAI (LM Studio, llama.cpp…)
PROVEEDOR_LLM=ollama
# Nombre del modelo tal como lo muestra el servidor (en Ollama, gemma3:4b)
LLM=gemma3:4b
# Con PROVEEDOR_LLM=ollama. Cambia localhost por la IP del otro equipo si Ollama corre allá.
OLLAMA_URL=http://localhost:11434
# Con PROVEEDOR_LLM=openai. LM Studio usa http://localhost:1234/v1.
LLM_URL=http://localhost:1234/v1
# LLM_API_KEY: los servidores locales no la piden. Si usas un servicio que sí la pide, guárdala
# igual que SUPABASE_DB_URL: ../.venv/bin/python -m app.rag.secretos guardar LLM_API_KEY
# Igual al contexto con que el servidor cargó el modelo
CONTEXTO_TOKENS=4096

# API: «local» (por defecto) responde con los modelos; «simulador», con respuestas fijas y sin
# modelos, para integrar la plataforma (ver «Simulador para integrar la plataforma» en el README).
MODO=local
# CLAVE_SERVICIO: si la defines, POST /ia/consultar-guia exige «Authorization: Bearer <clave>».
# Guárdala igual que SUPABASE_DB_URL: ../.venv/bin/python -m app.rag.secretos guardar CLAVE_SERVICIO
# En un servidor sin llavero (p. ej. Render), defínela como variable de entorno. Sin ella, la API no pide clave.
