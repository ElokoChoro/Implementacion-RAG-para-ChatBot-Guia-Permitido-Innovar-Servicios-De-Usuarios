# Copia este archivo como .env y completa tus credenciales.
# Los valores de Supabase están en: https://supabase.com/dashboard/project/<tu-project-ref>/settings/api

VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Backend (Python). No llevan el prefijo VITE_, así que Vite no las expone al navegador.
# Vector store del índice: chroma (local) o pgvector (Supabase)
ALMACEN=chroma
# Connection string de Postgres (Project Settings › Database › Connection string › Session pooler),
# con la contraseña de la base. Da acceso completo: no la compartas ni la uses en el frontend.
# postgresql://postgres.<project-ref>:<contraseña>@aws-0-<región>.pooler.supabase.com:5432/postgres
SUPABASE_DB_URL=

# LLM que redacta la respuesta (ver «LLM en cada equipo» en el README).
# ollama (por defecto) u openai: cualquier servidor compatible con la API de OpenAI (LM Studio, llama.cpp…)
PROVEEDOR_LLM=ollama
# Nombre del modelo tal como lo muestra el servidor (en Ollama, gemma3:4b)
LLM=gemma3:4b
# Con PROVEEDOR_LLM=ollama. Cambia localhost por la IP del otro equipo si Ollama corre allá.
OLLAMA_URL=http://localhost:11434
# Con PROVEEDOR_LLM=openai. LM Studio usa http://localhost:1234/v1.
LLM_URL=http://localhost:1234/v1
# Los servidores locales aceptan cualquier texto. Si es un servicio en la nube, es una credencial:
# no la compartas ni la subas al repositorio.
LLM_API_KEY=sin-clave
# Igual al contexto con que el servidor cargó el modelo
CONTEXTO_TOKENS=4096
