# Copiá este archivo como .env y completá tus credenciales
# Encontrás los valores en: https://supabase.com/dashboard/project/<tu-project-ref>/settings/api

VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Backend (Python). No llevan el prefijo VITE_, así que Vite no las expone al navegador.
# Vector store del índice: chroma (local) o pgvector (Supabase)
ALMACEN=chroma
# Connection string de Postgres (Project Settings › Database › Connection string › Session pooler),
# con la contraseña de la base. Da acceso completo: no la compartas ni la uses en el frontend.
# postgresql://postgres.<project-ref>:<contraseña>@aws-0-<región>.pooler.supabase.com:5432/postgres
SUPABASE_DB_URL=
