# Copia este archivo como .env. Configura el backend (Python); las credenciales no van aquí
# sino en el llavero del sistema (ver secretos.py).

# Vector store del índice: chroma (local) o pgvector (Supabase)
ALMACEN=chroma
# SUPABASE_DB_URL (connection string de Postgres con la contraseña de la base) NO va aquí: da acceso
# completo a la base y se guarda cifrada en el llavero del sistema. Desde backend/:
#   ../.venv/bin/python -m app.rag.secretos guardar SUPABASE_DB_URL
# Solo donde no hay llavero (CI, servidor) se define como variable de entorno.

# LLM que redacta la respuesta (ver «LLM en cada equipo» en el README).
# ollama (por defecto) u openai: cualquier servidor compatible con la API de OpenAI (LM Studio, llama.cpp…)
PROVEEDOR_LLM=ollama
# Nombre del modelo tal como lo muestra el servidor (en Ollama, gemma3:4b)
LLM=gemma3:4b
# Con PROVEEDOR_LLM=ollama. Cambia localhost por la IP del otro equipo si Ollama corre allá.
OLLAMA_URL=http://localhost:11434
# Con PROVEEDOR_LLM=openai. LM Studio usa http://localhost:1234/v1.
LLM_URL=http://localhost:1234/v1
# LLM_API_KEY no va aquí. Los servidores locales no la piden; si usas un servicio que sí la pide,
# guárdala en el llavero desde backend/: ../.venv/bin/python -m app.rag.secretos guardar LLM_API_KEY
# Igual al contexto con que el servidor cargó el modelo
CONTEXTO_TOKENS=4096

# API: «local» (por defecto) responde con los modelos; «simulador», con respuestas fijas y sin
# modelos, para integrar la plataforma (ver «Simulador para integrar la plataforma» en el README).
MODO=local
# CLAVE_SERVICIO no va aquí. Si la defines, POST /ia/consultar-guia exige «Authorization: Bearer <clave>».
# Guárdala en el llavero desde backend/: ../.venv/bin/python -m app.rag.secretos guardar CLAVE_SERVICIO
# En un servidor sin llavero (p. ej. Render), defínela como variable de entorno. Sin ella, la API no pide clave.
# Cola de la API: consultas que esperan turno mientras se atiende una, y cuánto esperan antes de 503.
COLA_MAXIMA=2
ESPERA_TURNO_S=300
# true: carga los modelos al arrancar la API (conviene en un servidor que atiende a la plataforma).
PRECARGAR=false
